# Copy this file to server/.env — the app runs fine with everything below
# left as-is except ANTHROPIC_API_KEY, which is optional (see README).

DATABASE_URL="file:./dev.db"

PORT=4000
JWT_SECRET=claimsetu-dev-secret-change-me

# Get a key from https://console.anthropic.com/ — without it the app still
# runs, but the AI panels (case summaries, risk scoring, adjudication
# drafting, the member chat assistant) show a "connect your key" placeholder
# instead of live output.
ANTHROPIC_API_KEY=

# Safe to bump to a newer Claude model if your key supports one.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
